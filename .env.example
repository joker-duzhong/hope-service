# Hope Service 环境变量配置

# ==================== 基础配置 ====================
DEBUG=true

# ==================== 数据库配置 ====================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hope_service

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== JWT 配置 ====================
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 微信公众号配置 ====================
WECHAT_APPS=wxappid1:your_secret1:your_token1:your_encoding_aes_key1,wxappid2:your_secret2:your_token2:your_encoding_aes_key2

# ==================== 飞书webhook ====================
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_id

# ==================== LLM 配置 ====================
LLM_PROVIDERS='{"openai": {"api_key": "sk-...", "base_url": "https://api.openai.com/v1", "default_model": "gpt-4o"}}'
LLM_DEFAULT_PROVIDER="openai"

# ==================== 七牛云 OSS 配置 ====================
QINIU_ACCESS_KEY=""
QINIU_SECRET_KEY=""
QINIU_BUCKET_NAME=""
QINIU_DOMAIN=""  # 访问域名，如 http://oss.yourdomain.com

# ==================== 腾讯云短信配置 ====================
TENCENT_SMS_SECRET_ID=""
TENCENT_SMS_SECRET_KEY=""
TENCENT_SMS_APP_ID=""
TENCENT_SMS_SIGN_NAME=""
TENCENT_SMS_TEMPLATE_ID_REGISTER=""
TENCENT_SMS_TEMPLATE_ID_BIND=""
TENCENT_SMS_REGION=ap-guangzhou

# ==================== 端口配置 ====================
APP_PORT=8000
